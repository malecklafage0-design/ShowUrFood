  <script>
    // ==================== 1. PWA ICON, MANIFEST & SERVICE WORKER ====================
    function generateAppIconDataURL(size) {
      const canvas = document.createElement("canvas");
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext("2d");

      // Dark background with rounded corners
      const radius = size * 0.22;
      ctx.beginPath();
      ctx.moveTo(radius, 0);
      ctx.lineTo(size - radius, 0);
      ctx.quadraticCurveTo(size, 0, size, radius);
      ctx.lineTo(size, size - radius);
      ctx.quadraticCurveTo(size, size, size - radius, size);
      ctx.lineTo(radius, size);
      ctx.quadraticCurveTo(0, size, 0, size - radius);
      ctx.lineTo(0, radius);
      ctx.quadraticCurveTo(0, 0, radius, 0);
      ctx.closePath();

      const bgGrad = ctx.createLinearGradient(0, 0, size, size);
      bgGrad.addColorStop(0, "#181b24");
      bgGrad.addColorStop(1, "#0f1115");
      ctx.fillStyle = bgGrad;
      ctx.fill();

      // Subtle glowing orange border ring
      ctx.lineWidth = size * 0.035;
      const ringGrad = ctx.createLinearGradient(0, 0, size, size);
      ringGrad.addColorStop(0, "#f97316");
      ringGrad.addColorStop(1, "#f59e0b");
      ctx.strokeStyle = ringGrad;
      ctx.stroke();

      // Center radial glow
      const glow = ctx.createRadialGradient(size * 0.5, size * 0.48, size * 0.05, size * 0.5, size * 0.5, size * 0.42);
      glow.addColorStop(0, "rgba(249, 115, 22, 0.38)");
      glow.addColorStop(1, "rgba(249, 115, 22, 0)");
      ctx.fillStyle = glow;
      ctx.fillRect(0, 0, size, size);

      // Stylized Flame + Burger Dome
      ctx.save();
      ctx.translate(size * 0.5, size * 0.52);

      // Flame top
      const flameGrad = ctx.createLinearGradient(0, -size * 0.34, 0, size * 0.06);
      flameGrad.addColorStop(0, "#fde047");
      flameGrad.addColorStop(0.5, "#f97316");
      flameGrad.addColorStop(1, "#e11d48");
      ctx.fillStyle = flameGrad;

      ctx.beginPath();
      ctx.moveTo(0, -size * 0.33);
      ctx.bezierCurveTo(size * 0.19, -size * 0.16, size * 0.21, size * 0.02, 0, size * 0.07);
      ctx.bezierCurveTo(-size * 0.21, size * 0.02, -size * 0.19, -size * 0.16, 0, -size * 0.33);
      ctx.fill();

      // Inner star sparkle
      ctx.fillStyle = "#fffbeb";
      ctx.beginPath();
      ctx.arc(0, -size * 0.09, size * 0.042, 0, Math.PI * 2);
      ctx.fill();

      // Burger Patty & Bottom Bun bars
      ctx.fillStyle = "#fb923c";
      ctx.beginPath();
      ctx.roundRect(-size * 0.24, size * 0.11, size * 0.48, size * 0.055, size * 0.028);
      ctx.fill();

      ctx.fillStyle = "#f8fafc";
      ctx.beginPath();
      ctx.roundRect(-size * 0.21, size * 0.195, size * 0.42, size * 0.065, size * 0.032);
      ctx.fill();

      ctx.restore();
      return canvas.toDataURL("image/png");
    }

    function initPWA() {
      try {
        const icon192 = generateAppIconDataURL(192);
        const icon512 = generateAppIconDataURL(512);

        document.getElementById("apple-touch-icon").href = icon192;
        document.getElementById("favicon-link").href = icon192;
        const modalIcon = document.getElementById("modal-app-icon");
        if (modalIcon) modalIcon.src = icon192;

        const manifestObj = {
          name: "Show My Food",
          short_name: "ShowMyFood",
          description: "Le battle culinaire local : vote pour les meilleurs plats autour de toi et gagne des récompenses.",
          start_url: "./",
          display: "standalone",
          orientation: "portrait",
          theme_color: "#0f1115",
          background_color: "#0f1115",
          icons: [
            { src: icon192, sizes: "192x192", type: "image/png", purpose: "any maskable" },
            { src: icon512, sizes: "512x512", type: "image/png", purpose: "any maskable" }
          ]
        };

        const manifestBlob = new Blob([JSON.stringify(manifestObj)], { type: "application/manifest+json" });
        const manifestURL = URL.createObjectURL(manifestBlob);
        document.getElementById("pwa-manifest").href = manifestURL;

        // Register Offline Service Worker via Blob URL (with graceful fallback in sandboxed/file contexts)
        if ("serviceWorker" in navigator && (window.location.protocol === "https:" || window.location.hostname === "localhost")) {
          const swCode = `
            const CACHE_NAME = 'show-my-food-v1';
            self.addEventListener('install', (event) => {
              self.skipWaiting();
            });
            self.addEventListener('activate', (event) => {
              event.waitUntil(self.clients.claim());
            });
            self.addEventListener('fetch', (event) => {
              event.respondWith(
                caches.match(event.request).then((cached) => {
                  return cached || fetch(event.request).then((response) => {
                    if (event.request.method === 'GET' && response.status === 200) {
                      const copy = response.clone();
                      caches.open(CACHE_NAME).then((cache) => cache.put(event.request, copy));
                    }
                    return response;
                  }).catch(() => cached);
                })
              );
            });
          `;
          const swBlob = new Blob([swCode], { type: "application/javascript" });
          const swUrl = URL.createObjectURL(swBlob);
          navigator.serviceWorker.register(swUrl).catch(() => {});
        }
      } catch (e) {
        // Graceful fallback in restricted iframes
      }
    }

    // Capture native install prompt if available
    let deferredInstallPrompt = null;
    window.addEventListener("beforeinstallprompt", (e) => {
      e.preventDefault();
      deferredInstallPrompt = e;
      const nativeBox = document.getElementById("native-install-box");
      if (nativeBox) nativeBox.classList.remove("hidden");
    });

    // ==================== 2. STATE & LOCALSTORAGE PERSISTENCE ====================
    const STORAGE_KEY = "show_my_food_pwa_state_v1";

    const DEFAULT_DISHES = [
