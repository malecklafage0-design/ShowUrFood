<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Show My Food — Le Battle Culinaire Local</title>

  <!-- PWA & Mobile Meta Tags -->
  <meta name="application-name" content="Show My Food" />
  <meta name="apple-mobile-web-app-title" content="Show My Food" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="theme-color" content="#0f1115" />
  <meta name="description" content="Vote pour les meilleurs plats autour de toi, grimpe dans le Top Tiers du jour et débloque des récompenses locales." />

  <!-- Dynamic Manifest & Icons injected via JS -->
  <link id="pwa-manifest" rel="manifest" href="" />
  <link id="apple-touch-icon" rel="apple-touch-icon" href="" />
  <link id="favicon-link" rel="icon" type="image/png" href="" />

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            darkbg: '#0f1115',
            darkcard: '#171a21',
            darkborder: '#252a34',
            brand: {
              400: '#fb923c',
              500: '#f97316',
              600: '#ea580c',
            }
          }
        }
      }
    }
  </script>

  <style>
    * {
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      box-sizing: border-box;
    }
    input, textarea, select {
      user-select: text;
    }
    html, body {
      font-family: 'Inter', sans-serif;
      background-color: #08090c;
      color: #f8fafc;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      height: 100%;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .card-spring {
      transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.32s ease;
    }
    .card-dragging {
      transition: none !important;
      cursor: grabbing !important;
    }
    @keyframes pulsePop {
      0% { transform: scale(0.92); opacity: 0; }
      60% { transform: scale(1.04); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }
    .animate-pop {
      animation: pulsePop 0.28s ease-out forwards;
    }
    @keyframes scanBeam {
      0% { top: 4%; opacity: 0.2; }
      50% { top: 88%; opacity: 1; }
      100% { top: 4%; opacity: 0.2; }
    }
    .scan-line {
      animation: scanBeam 1.3s ease-in-out infinite;
    }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center bg-[#07080b] sm:py-3">

  <!-- Mobile-First PWA App Shell -->
  <div id="app-shell" class="relative w-full h-[100dvh] sm:h-[852px] sm:max-w-[424px] bg-[#0f1115] sm:rounded-[38px] sm:shadow-[0_25px_80px_-15px_rgba(249,115,22,0.22)] sm:border-[6px] sm:border-[#1f2430] flex flex-col overflow-hidden text-slate-100">

    <!-- Smart Install Banner (dismissible) -->
    <div id="install-banner" class="bg-gradient-to-r from-orange-600 via-amber-500 to-orange-600 text-white px-3.5 py-2 flex items-center justify-between gap-2 z-40 shrink-0 shadow-md">
      <div class="flex items-center gap-2 min-w-0">
        <span class="text-base shrink-0">📲</span>
        <div class="min-w-0">
          <p class="text-[11px] font-black leading-tight truncate">Installe Show My Food sur ton écran</p>
          <p class="text-[10px] text-orange-100 truncate">Accès plein écran & hors-ligne • 0 Mo sur store</p>
        </div>
      </div>
      <div class="flex items-center gap-1.5 shrink-0">
        <button id="banner-install-btn" class="bg-slate-950 hover:bg-slate-900 text-white text-[11px] font-extrabold px-2.5 py-1 rounded-full shadow-xs active:scale-95 transition">
          Installer
        </button>
        <button id="close-banner-btn" aria-label="Fermer" class="text-white/80 hover:text-white text-xs font-bold px-1.5 py-1">
          ✕
        </button>
      </div>
    </div>

    <!-- Top Header -->
    <header class="bg-[#0f1115]/95 backdrop-blur-md border-b border-[#252a34] px-4 pt-3 pb-2.5 z-30 shrink-0">
      <div class="flex items-center justify-between gap-2">
        <!-- Brand Logo -->
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="w-9 h-9 rounded-2xl bg-gradient-to-br from-orange-500 via-amber-500 to-rose-600 flex items-center justify-center text-white shadow-lg shadow-orange-500/30 shrink-0">
            <!-- Inline SVG Flame Burger Emblem -->
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2c.5 2.5 2 3.8 2 6a2 2 0 1 1-4 0c0-1.1.4-2.1 1-3-1.8.8-3 2.7-3 4.8A4 4 0 0 0 12 14a4 4 0 0 0 4-4.2C16 6.8 14.3 4 12 2Z" fill="currentColor"/>
              <path d="M4 16h16" />
              <path d="M5 19.5h14a1 1 0 0 0 1-1v-.5H4v.5a1 1 0 0 0 1 1Z" fill="currentColor"/>
            </svg>
          </div>
          <div class="min-w-0">
            <h1 class="font-black text-[16px] tracking-tight text-white leading-none truncate">Show My Food</h1>
            <div class="flex items-center gap-1.5 mt-1">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span id="service-slot-label" class="text-[10px] font-bold text-orange-400 truncate">Battle du Soir • En direct</span>
            </div>
          </div>
        </div>

        <!-- Points Counter + Install Trigger -->
        <div class="flex items-center gap-1.5 shrink-0">
          <div class="bg-[#171a21] border border-[#2b313e] px-2.5 py-1.5 rounded-full flex items-center gap-1 shadow-xs" title="Tes points Foodies">
            <span class="text-xs">🔥</span>
            <span id="user-points" class="text-xs font-black text-amber-400">140</span>
          </div>
          <button id="header-install-btn" class="bg-orange-500/15 hover:bg-orange-500/25 border border-orange-500/40 text-orange-400 text-[11px] font-extrabold px-2.5 py-1.5 rounded-full flex items-center gap-1 active:scale-95 transition" title="Installer l'application">
            <span>📲</span>
            <span>Installer</span>
          </button>
        </div>
      </div>

      <!-- Zone Selector Bar -->
      <div class="mt-2.5 flex items-center gap-2">
        <div class="relative flex-1">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-xs">📍</span>
          <select id="zone-selector" class="w-full appearance-none bg-[#171a21] hover:bg-[#1e222b] border border-[#282e3a] text-slate-100 text-xs font-bold rounded-xl pl-8 pr-8 py-2 focus:outline-none focus:ring-2 focus:ring-orange-500 transition cursor-pointer">
            <option value="ALL">Tout autour de moi (France)</option>
            <option value="Paris 11e • Bastille" selected>Paris 11e • Bastille</option>
            <option value="Lyon • Presqu'île">Lyon • Presqu'île</option>
            <option value="Marseille • Vieux-Port">Marseille • Vieux-Port</option>
            <option value="Bordeaux • Centre">Bordeaux • Centre</option>
          </select>
          <span class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[10px]">▼</span>
        </div>
        <button id="toggle-slot-btn" class="shrink-0 bg-[#171a21] border border-[#282e3a] hover:border-orange-500/50 text-slate-300 text-[11px] font-bold px-2.5 py-2 rounded-xl active:scale-95 transition" title="Changer de créneau">
          🕒 Créneau
        </button>
      </div>
    </header>

    <!-- Toast Notification Container -->
    <div id="toast-container" class="pointer-events-none fixed sm:absolute top-32 left-1/2 -translate-x-1/2 z-50 w-[90%] max-w-[360px] flex flex-col items-center gap-2"></div>

    <!-- MAIN SCROLLABLE AREA -->
    <main class="flex-1 overflow-y-auto overflow-x-hidden relative">

      <!-- ==================== TAB 1: DECK SWIPE (VOTER) ==================== -->
      <section id="tab-swipe" class="h-full flex flex-col px-4 pt-3 pb-3">
        <!-- Category Filter Pills -->
        <div class="flex items-center justify-between gap-1.5 mb-2.5 shrink-0">
          <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5">
            <button data-swipe-cat="ALL" class="swipe-cat-btn active px-3 py-1 rounded-full text-xs font-extrabold bg-orange-500 text-white shadow-xs transition">Tout</button>
            <button data-swipe-cat="Fait maison" class="swipe-cat-btn px-3 py-1 rounded-full text-xs font-bold bg-[#171a21] text-slate-300 border border-[#282e3a] hover:border-orange-500/40 transition">🏠 Fait maison</button>
            <button data-swipe-cat="Restaurant" class="swipe-cat-btn px-3 py-1 rounded-full text-xs font-bold bg-[#171a21] text-slate-300 border border-[#282e3a] hover:border-orange-500/40 transition">🍽️ Resto</button>
            <button data-swipe-cat="Concept" class="swipe-cat-btn px-3 py-1 rounded-full text-xs font-bold bg-[#171a21] text-slate-300 border border-[#282e3a] hover:border-orange-500/40 transition">✨ Concept</button>
          </div>
          <span id="deck-counter" class="text-[11px] font-bold text-slate-400 shrink-0">0 plat</span>
        </div>

        <!-- Card Stack Wrapper -->
        <div id="card-stack-wrapper" class="relative flex-1 w-full min-h-[350px] flex items-center justify-center">
          <!-- Cards rendered dynamically -->
        </div>

        <!-- Bottom Action Buttons -->
        <div id="swipe-controls" class="pt-3 pb-1 flex items-center justify-center gap-5 shrink-0">
          <button id="btn-pass" aria-label="Passer" class="w-14 h-14 rounded-full bg-[#171a21] border-2 border-rose-500/40 text-rose-400 shadow-lg shadow-black/40 flex items-center justify-center text-2xl hover:bg-rose-500/15 active:scale-90 transition">
            ✕
          </button>
          <button id="btn-super" aria-label="Super-Chef +3 pts" class="w-13 h-13 px-3.5 py-2 rounded-full bg-gradient-to-br from-amber-400 to-orange-600 text-white shadow-lg shadow-orange-500/30 flex flex-col items-center justify-center hover:brightness-110 active:scale-90 transition" title="Super-Chef (+3 pts)">
            <span class="text-lg leading-none">⭐</span>
            <span class="text-[9px] font-black leading-none mt-0.5">+3 pts</span>
          </button>
          <button id="btn-like" aria-label="MIAM +1 pt" class="w-14 h-14 rounded-full bg-gradient-to-br from-emerald-500 to-teal-600 text-white shadow-lg shadow-emerald-500/30 flex items-center justify-center text-2xl hover:brightness-110 active:scale-90 transition" title="MIAM (+1 pt)">
            🔥
          </button>
        </div>
      </section>

      <!-- ==================== TAB 2: TOP TIERS (CLASSEMENT) ==================== -->
      <section id="tab-leaderboard" class="hidden px-4 pt-3 pb-6 space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-lg font-black text-white">Top Tiers du Jour 🏆</h2>
            <p id="leaderboard-subtitle" class="text-xs text-slate-400 font-medium">Classement en direct • Paris 11e • Bastille</p>
          </div>
          <span class="text-[11px] font-extrabold bg-orange-500/15 text-orange-400 border border-orange-500/30 px-2.5 py-1 rounded-full">Fin 23h59</span>
        </div>

        <!-- Category Filter Pills -->
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar">
          <button data-lb-cat="ALL" class="lb-cat-btn px-3 py-1.5 rounded-full text-xs font-extrabold bg-orange-500 text-white shadow-xs transition">Tout le Top</button>
          <button data-lb-cat="Fait maison" class="lb-cat-btn px-3 py-1.5 rounded-full text-xs font-bold bg-[#171a21] text-slate-300 border border-[#282e3a] transition">🏠 Fait maison</button>
          <button data-lb-cat="Restaurant" class="lb-cat-btn px-3 py-1.5 rounded-full text-xs font-bold bg-[#171a21] text-slate-300 border border-[#282e3a] transition">🍽️ Restaurant</button>
          <button data-lb-cat="Concept" class="lb-cat-btn px-3 py-1.5 rounded-full text-xs font-bold bg-[#171a21] text-slate-300 border border-[#282e3a] transition">✨ Concept</button>
        </div>

        <!-- Visual Podium Top 3 -->
        <div id="podium-container" class="bg-gradient-to-b from-[#1e1b18] via-[#171a21] to-[#171a21] border border-orange-500/30 rounded-3xl p-3.5 shadow-lg">
          <!-- Rendered dynamically -->
        </div>

        <!-- Ranks 4+ -->
        <div>
          <h3 class="text-[11px] font-extrabold uppercase tracking-wider text-slate-500 mb-2 px-1">Suite du classement</h3>
          <div id="ranking-list" class="space-y-2.5">
            <!-- Rendered dynamically -->
          </div>
        </div>
      </section>

      <!-- ==================== TAB 3: POSTER MON PLAT (+ POSTER) ==================== -->
      <section id="tab-post" class="hidden px-4 pt-3 pb-6 space-y-4">
        <div>
          <h2 class="text-lg font-black text-white">Montre ton assiette 📸</h2>
          <p class="text-xs text-slate-400 font-medium">L'IA analyse ton plat et le propulse en tête du deck et du classement.</p>
        </div>

        <!-- Photo Capture / Preview Box -->
        <div class="bg-[#171a21] border-2 border-dashed border-[#2e3545] rounded-3xl p-3.5 text-center relative overflow-hidden">
          <div id="post-preview-empty" class="py-4 flex flex-col items-center">
            <div class="w-12 h-12 rounded-2xl bg-orange-500/15 border border-orange-500/30 text-orange-400 flex items-center justify-center text-2xl mb-2">
              🍽️
            </div>
            <p class="text-sm font-bold text-slate-100">Prends ou importe la photo de ton plat</p>
            <p class="text-[11px] text-slate-400 mt-0.5 mb-3">Caméra directe ou galerie photo</p>
            <label class="inline-flex items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white text-xs font-extrabold px-4 py-2.5 rounded-xl cursor-pointer active:scale-95 transition shadow-md shadow-orange-500/20">
              <span>📷 Choisir / Prendre une photo</span>
              <input id="photo-input" type="file" accept="image/*" class="hidden" />
            </label>
          </div>

          <div id="post-preview-filled" class="hidden relative rounded-2xl overflow-hidden">
            <img id="post-preview-img" src="" alt="Aperçu du plat" class="w-full h-52 object-cover rounded-2xl" />
            <!-- AI Scan Laser Overlay (shown during scan) -->
            <div id="ai-scan-overlay" class="hidden absolute inset-0 bg-indigo-950/50 backdrop-blur-[1px]">
              <div class="scan-line absolute left-0 right-0 h-1 bg-gradient-to-r from-transparent via-cyan-400 to-transparent shadow-[0_0_15px_#22d3ee]"></div>
              <div class="absolute bottom-3 left-1/2 -translate-x-1/2 bg-slate-950/90 border border-cyan-400/50 text-cyan-300 text-[11px] font-extrabold px-3 py-1 rounded-full whitespace-nowrap">
                🤖 Scan nutritionnel & catégorie IA...
              </div>
            </div>
            <button id="clear-photo-btn" type="button" class="absolute top-2.5 right-2.5 bg-slate-950/80 text-white text-xs font-bold px-2.5 py-1 rounded-full border border-white/15 hover:bg-slate-900">
              Changer
            </button>
          </div>

          <!-- 3 Realistic Sample Dishes for 1-Click Testing -->
          <div class="mt-3 pt-3 border-t border-[#252a34]">
            <p class="text-[11px] font-bold text-slate-400 mb-2">Ou teste en 1 clic avec un plat d'exemple :</p>
            <div class="grid grid-cols-3 gap-2">
              <button type="button" class="sample-dish-btn group relative rounded-xl overflow-hidden border border-[#2b313e] hover:border-orange-500 bg-[#0f1115] transition"
                data-url="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=800&q=80"
                data-title="Double Smash Burger Cheddar Affiné"
                data-cat="Restaurant"
                data-resto="Smash & Co Bastille"
                data-desc="Pain brioché toasté, double steak smashé croustillant, cheddar affiné 12 mois et sauce secrète."
                data-kcal="840" data-p="46" data-g="58" data-l="45">
                <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=300&q=70" alt="Burger" class="w-full h-14 object-cover group-hover:scale-105 transition" />
                <span class="block text-[10px] font-bold py-1 text-slate-200 truncate px-1">Smash Burger</span>
              </button>

              <button type="button" class="sample-dish-btn group relative rounded-xl overflow-hidden border border-[#2b313e] hover:border-orange-500 bg-[#0f1115] transition"
                data-url="https://images.unsplash.com/photo-1569718212165-3a8278d5f624?auto=format&fit=crop&w=800&q=80"
                data-title="Ramen Tonkotsu Œuf Mariné Maison"
                data-cat="Fait maison"
                data-resto=""
                data-desc="Bouillon mijoté 8h, nouilles fraîches, œuf mollet mariné au soja et ciboule croquante."
                data-kcal="620" data-p="34" data-g="68" data-l="21">
                <img src="https://images.unsplash.com/photo-1569718212165-3a8278d5f624?auto=format&fit=crop&w=300&q=70" alt="Ramen" class="w-full h-14 object-cover group-hover:scale-105 transition" />
                <span class="block text-[10px] font-bold py-1 text-slate-200 truncate px-1">Ramen Maison</span>
              </button>

              <button type="button" class="sample-dish-btn group relative rounded-xl overflow-hidden border border-[#2b313e] hover:border-orange-500 bg-[#0f1115] transition"
                data-url="https://images.unsplash.com/photo-1551024601-bec78aea704b?auto=format&fit=crop&w=800&q=80"
                data-title="Donut Pistache Craquant & Or"
                data-cat="Concept"
                data-resto="Atelier Sucré"
                data-desc="Brioche filante glacée à la pâte de pistache torréfiée, éclats de praliné et feuille d'or."
                data-kcal="490" data-p="9" data-g="56" data-l="25">
                <img src="https://images.unsplash.com/photo-1551024601-bec78aea704b?auto=format&fit=crop&w=300&q=70" alt="Donut" class="w-full h-14 object-cover group-hover:scale-105 transition" />
                <span class="block text-[10px] font-bold py-1 text-slate-200 truncate px-1">Donut Concept</span>
              </button>
            </div>
          </div>
        </div>

        <!-- AI Analyze Trigger Button -->
        <button id="ai-analyze-btn" type="button" class="w-full py-3 px-4 rounded-2xl bg-gradient-to-r from-indigo-600 via-violet-600 to-purple-600 text-white font-extrabold text-xs shadow-lg shadow-indigo-500/25 flex items-center justify-center gap-2 hover:brightness-110 active:scale-[0.98] transition">
          <span id="ai-btn-icon">✨</span>
          <span id="ai-btn-text">Analyser mon plat avec l'IA (Titre + Macros)</span>
        </button>

        <!-- AI Nutrition & Macros Box -->
        <div id="ai-nutrition-box" class="hidden bg-indigo-950/40 border border-indigo-500/35 rounded-2xl p-3 space-y-2 animate-pop">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-extrabold text-indigo-300">✨ Estimation Nutritionnelle IA</span>
            <span id="ai-kcal-badge" class="text-xs font-black bg-indigo-600 text-white px-2.5 py-0.5 rounded-full">650 kcal</span>
          </div>
          <div class="grid grid-cols-3 gap-2 text-center">
            <div class="bg-[#0f1115] rounded-xl py-1.5 px-2 border border-indigo-500/20">
              <div class="text-[10px] font-semibold text-slate-400">Protéines</div>
              <div id="ai-prot" class="text-xs font-black text-white">32g</div>
            </div>
            <div class="bg-[#0f1115] rounded-xl py-1.5 px-2 border border-indigo-500/20">
              <div class="text-[10px] font-semibold text-slate-400">Glucides</div>
              <div id="ai-carbs" class="text-xs font-black text-white">54g</div>
            </div>
            <div class="bg-[#0f1115] rounded-xl py-1.5 px-2 border border-indigo-500/20">
              <div class="text-[10px] font-semibold text-slate-400">Lipides</div>
              <div id="ai-fats" class="text-xs font-black text-white">24g</div>
            </div>
          </div>
        </div>

        <!-- Dish Submission Form -->
        <form id="publish-dish-form" class="space-y-3 bg-[#171a21] p-4 rounded-3xl border border-[#252a34]">
          <div>
            <label class="block text-[11px] font-extrabold text-slate-300 mb-1">Nom du plat *</label>
            <input id="dish-title" type="text" required placeholder="Ex. Pâtes fraîches à la truffe noire" class="w-full bg-[#0f1115] border border-[#282e3a] text-white rounded-xl px-3 py-2 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-orange-500" />
          </div>

          <div class="grid grid-cols-2 gap-2.5">
            <div>
              <label class="block text-[11px] font-extrabold text-slate-300 mb-1">Catégorie *</label>
              <select id="dish-category" class="w-full bg-[#0f1115] border border-[#282e3a] text-white rounded-xl px-2.5 py-2 text-xs font-bold focus:outline-none focus:ring-2 focus:ring-orange-500">
                <option value="Fait maison">🏠 Fait maison</option>
                <option value="Restaurant">🍽️ Restaurant</option>
                <option value="Concept">✨ Concept</option>
              </select>
            </div>
            <div>
              <label class="block text-[11px] font-extrabold text-slate-300 mb-1">Zone du battle *</label>
              <select id="dish-zone" class="w-full bg-[#0f1115] border border-[#282e3a] text-white rounded-xl px-2.5 py-2 text-xs font-bold focus:outline-none focus:ring-2 focus:ring-orange-500">
                <option value="Paris 11e • Bastille">Paris 11e • Bastille</option>
                <option value="Lyon • Presqu'île">Lyon • Presqu'île</option>
                <option value="Marseille • Vieux-Port">Marseille • Vieux-Port</option>
                <option value="Bordeaux • Centre">Bordeaux • Centre</option>
              </select>
            </div>
          </div>

          <div id="resto-name-wrapper" class="hidden">
            <label class="block text-[11px] font-extrabold text-slate-300 mb-1">Nom du restaurant / enseigne</label>
