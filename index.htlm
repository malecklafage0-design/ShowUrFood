        category: "Restaurant",
        restaurantName: "Le Comptoir Bordelais",
        description: "Pièce maturée 28 jours, beurre maître d'hôtel et frites croustillantes coupées au couteau.",
        image: "https://images.unsplash.com/photo-1600891964092-4316c288032e?auto=format&fit=crop&w=900&q=80",
        score: 1260,
        likes: 41,
