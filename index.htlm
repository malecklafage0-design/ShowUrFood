        kcal: 890,
        protein: 52,
        carbs: 64,
        fat: 47,
        isUserPost: false
      }
    ];

    const REWARDS_CATALOG = [
      {
        id: "r1",
        cost: 150,
        title: "-20% sur l'addition chez Smash & Co",
        partner: "Smash & Co • Valable midi & soir",
        code: "SHOWFOOD20",
        emoji: "🍔"
      },
      {
        id: "r2",
        cost: 200,
        title: "1 Café de spécialité + Cookie offert",
        partner: "Torréfaction & Co • Sans minimum",
        code: "COOKIEVIP",
        emoji: "🍪"
      },
      {
        id: "r3",
        cost: 350,
        title: "Menu Ramen Complet Offert (19€)",
        partner: "Ramen Bar • Top Foodie Local",
        code: "RAMENKING",
        emoji: "🍜"
      }
    ];

    const serviceSlots = [
      "Battle du Soir • En direct",
      "Battle du Midi • 12h-14h",
      "Goûter & Street-Food • 15h-18h"
    ];

    let appState = {
      userPoints: 140,
      selectedZone: "Paris 11e • Bastille",
      swipedIds: [],
      unlockedRewards: [],
      dishes: JSON.parse(JSON.stringify(DEFAULT_DISHES)),
      bannerDismissed: false
    };

    function loadState() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          const parsed = JSON.parse(saved);
          appState = {
            ...appState,
            ...parsed,
            dishes: Array.isArray(parsed.dishes) && parsed.dishes.length > 0 ? parsed.dishes : JSON.parse(JSON.stringify(DEFAULT_DISHES)),
            swipedIds: Array.isArray(parsed.swipedIds) ? parsed.swipedIds : [],
            unlockedRewards: Array.isArray(parsed.unlockedRewards) ? parsed.unlockedRewards : []
          };
        }
      } catch (e) {
        // Fallback to default state if storage unavailable
      }
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
      } catch (e) {
        // Ignore quota errors if very large base64 photo is used
      }
    }

    let currentSlotIndex = 0;
    let swipeCategoryFilter = "ALL";
    let leaderboardCategoryFilter = "ALL";

    // ==================== 3. UI HELPERS ====================
    function showToast(message, type = "info") {
      const container = document.getElementById("toast-container");
      const toast = document.createElement("div");
      const styles = {
        success: "bg-emerald-600 text-white border border-emerald-400/40",
        super: "bg-gradient-to-r from-amber-500 to-orange-600 text-white border border-amber-300/40",
        pass: "bg-slate-800 text-slate-200 border border-slate-700",
        error: "bg-rose-600 text-white border border-rose-400/40",
        info: "bg-slate-900 text-white border border-slate-700"
      };
      toast.className = `${styles[type] || styles.info} px-4 py-2 rounded-full text-xs font-extrabold shadow-xl animate-pop text-center`;
      toast.textContent = message;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = "0";
        toast.style.transform = "translateY(-8px)";
        toast.style.transition = "all 0.25s ease";
        setTimeout(() => toast.remove(), 250);
      }, 2100);
    }

    function updateHeaderAndWalletUI() {
      document.getElementById("user-points").textContent = appState.userPoints;
      document.getElementById("zone-selector").value = appState.selectedZone;
      document.getElementById("rewards-zone-tag").textContent = appState.selectedZone === "ALL" ? "Toute la France" : appState.selectedZone;

      const bigPts = document.getElementById("rewards-points-big");
      if (bigPts) bigPts.textContent = appState.userPoints;

      const progLabel = document.getElementById("points-progress-label");
      const progBar = document.getElementById("points-progress-bar");
      if (progLabel && progBar) {
        progLabel.textContent = `${appState.userPoints} / 200 pts`;
        progBar.style.width = `${Math.min(100, (appState.userPoints / 200) * 100)}%`;
      }

      if (appState.bannerDismissed) {
        document.getElementById("install-banner").classList.add("hidden");
      }
    }

    function getCategoryBadgeHTML(dish) {
      if (dish.category === "Fait maison") {
        return `<span class="inline-flex items-center gap-1 bg-emerald-500/95 text-white text-[11px] font-extrabold px-2.5 py-1 rounded-full shadow-sm">🏠 Fait maison</span>`;
      }
      if (dish.category === "Restaurant") {
        const restoLabel = dish.restaurantName ? ` • ${dish.restaurantName}` : "";
        return `<span class="inline-flex items-center gap-1 bg-orange-500/95 text-white text-[11px] font-extrabold px-2.5 py-1 rounded-full shadow-sm max-w-[220px] truncate">🍽️ Resto${restoLabel}</span>`;
      }
      return `<span class="inline-flex items-center gap-1 bg-purple-600/95 text-white text-[11px] font-extrabold px-2.5 py-1 rounded-full shadow-sm">✨ Concept</span>`;
    }

    function getApprovalRate(dish) {
      const total = dish.likes + dish.passes;
      return total === 0 ? 100 : Math.round((dish.likes / total) * 100);
    }

    // ==================== 4. DECK SWIPE LOGIC ====================
    function getFilteredSwipeDishes() {
      const swipedSet = new Set(appState.swipedIds);
      return appState.dishes.filter(d => {
        if (swipedSet.has(d.id)) return false;
        const zoneMatch = appState.selectedZone === "ALL" || d.zone === appState.selectedZone;
        const catMatch = swipeCategoryFilter === "ALL" || d.category === swipeCategoryFilter;
        return zoneMatch && catMatch;
      });
    }

    function renderSwipeDeck() {
      const wrapper = document.getElementById("card-stack-wrapper");
      const controls = document.getElementById("swipe-controls");
      const deckCounter = document.getElementById("deck-counter");
      const available = getFilteredSwipeDishes();

      deckCounter.textContent = `${available.length} plat${available.length > 1 ? "s" : ""}`;
      wrapper.innerHTML = "";

      if (available.length === 0) {
        controls.classList.add("opacity-40", "pointer-events-none");
        wrapper.innerHTML = `
          <div class="w-full h-full bg-[#171a21] border border-[#282e3a] rounded-3xl p-6 flex flex-col items-center justify-center text-center shadow-lg animate-pop">
            <div class="w-16 h-16 rounded-3xl bg-orange-500/15 border border-orange-500/30 text-3xl flex items-center justify-center mb-3">🍽️</div>
            <h3 class="text-base font-black text-white">Tu as voté sur tous les plats !</h3>
            <p class="text-xs text-slate-400 mt-1 max-w-[250px]">
              Tes votes ont mis à jour le Top Tiers du jour. Poste ton plat ou rejoue le deck !
            </p>
            <div class="mt-4 flex flex-col w-full gap-2">
              <button id="empty-go-post" class="w-full py-3 rounded-2xl bg-gradient-to-r from-orange-500 to-amber-500 text-white text-xs font-black shadow-md shadow-orange-500/25">
                ➕ Poster mon plat maintenant
              </button>
              <button id="empty-reset-deck" class="w-full py-2.5 rounded-2xl bg-[#0f1115] border border-[#2b313e] hover:border-orange-500/40 text-slate-200 text-xs font-bold transition">
                🔄 Rejouer les cartes
              </button>
            </div>
          </div>
        `;
        document.getElementById("empty-go-post")?.addEventListener("click", () => switchTab("post"));
        document.getElementById("empty-reset-deck")?.addEventListener("click", () => {
          appState.swipedIds = [];
          saveState();
          renderSwipeDeck();
          showToast("Deck rechargé !", "info");
        });
        return;
      }

      controls.classList.remove("opacity-40", "pointer-events-none");

      const visibleCards = available.slice(0, 3).reverse();
      visibleCards.forEach((dish, idx) => {
        const isTop = idx === visibleCards.length - 1;
        const stackOffset = visibleCards.length - 1 - idx;
        const approval = getApprovalRate(dish);

        const card = document.createElement("div");
        card.dataset.id = dish.id;
        card.className = `swipe-card absolute inset-0 rounded-[28px] overflow-hidden bg-[#171a21] shadow-2xl border border-white/10 ${isTop ? "cursor-grab z-20" : "pointer-events-none z-10"}`;
        card.style.transform = `scale(${1 - stackOffset * 0.04}) translateY(${stackOffset * 10}px)`;
        card.style.opacity = stackOffset === 2 ? "0.6" : "1";

        card.innerHTML = `
          <img src="${dish.image}" alt="${dish.title}" draggable="false" class="w-full h-full object-cover" onerror="this.src='https://placehold.co/600x800/171a21/f97316?text=Show+My+Food'" />
          
          <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/35 to-black/25 pointer-events-none"></div>

          <!-- Top Badges -->
          <div class="absolute top-3.5 left-3.5 right-3.5 flex items-start justify-between gap-2 pointer-events-none">
            ${getCategoryBadgeHTML(dish)}
            <div class="bg-black/65 backdrop-blur-md text-white px-2.5 py-1 rounded-full text-[11px] font-extrabold flex items-center gap-1 border border-white/15 shrink-0">
              <span>🔥 ${approval}%</span>
              <span class="text-white/40">•</span>
              <span class="text-amber-400">${dish.score}</span>
            </div>
          </div>

          <!-- Swipe Stamps -->
          <div class="stamp-like opacity-0 pointer-events-none absolute top-16 left-5 -rotate-12 border-4 border-emerald-400 bg-emerald-500/25 backdrop-blur-xs text-emerald-300 font-black text-2xl px-4 py-1 rounded-2xl tracking-wider shadow-lg">
            MIAM 🔥
          </div>
          <div class="stamp-pass opacity-0 pointer-events-none absolute top-16 right-5 rotate-12 border-4 border-rose-400 bg-rose-500/25 backdrop-blur-xs text-rose-300 font-black text-2xl px-4 py-1 rounded-2xl tracking-wider shadow-lg">
            NEXT ✕
          </div>

          <!-- Dish Details Overlay -->
          <div class="absolute bottom-0 left-0 right-0 p-4 text-white pointer-events-none">
            <div class="flex items-center gap-1.5 text-[11px] font-bold text-orange-400 mb-1">
              <span>${dish.author}</span>
              <span>•</span>
              <span>${dish.postedAgo}</span>
              <span>•</span>
              <span>${dish.distance}</span>
            </div>
            <h3 class="text-xl font-black leading-tight tracking-tight">${dish.title}</h3>
            <p class="text-xs text-slate-200/90 mt-1 line-clamp-2 leading-relaxed">${dish.description}</p>

            <div class="mt-3 pt-2.5 border-t border-white/15 flex items-center justify-between text-[11px]">
              <span class="text-slate-300 font-medium">📍 ${dish.zone}</span>
              <span class="bg-white/15 backdrop-blur-xs px-2.5 py-0.5 rounded-full font-bold text-amber-200">
                ✨ ~${dish.kcal} kcal • ${dish.protein}g prot
              </span>
            </div>
          </div>
        `;

        if (isTop) {
          attachDragHandlers(card, dish);
        }
        wrapper.appendChild(card);
      });
    }

    function attachDragHandlers(card, dish) {
      let startX = 0;
      let startY = 0;
      let currentX = 0;
      let isDragging = false;

      const stampLike = card.querySelector(".stamp-like");
      const stampPass = card.querySelector(".stamp-pass");

      const onPointerDown = (e) => {
        isDragging = true;
        startX = e.type.includes("mouse") ? e.clientX : e.touches[0].clientX;
        startY = e.type.includes("mouse") ? e.clientY : e.touches[0].clientY;
        card.classList.add("card-dragging");
        card.classList.remove("card-spring");
      };

      const onPointerMove = (e) => {
        if (!isDragging) return;
        const x = e.type.includes("mouse") ? e.clientX : e.touches[0].clientX;
        const y = e.type.includes("mouse") ? e.clientY : e.touches[0].clientY;
        currentX = x - startX;
        const currentY = (y - startY) * 0.25;
        const rotate = currentX * 0.06;

        card.style.transform = `translate(${currentX}px, ${currentY}px) rotate(${rotate}deg)`;

        const progress = Math.min(1, Math.abs(currentX) / 95);
        if (currentX > 15) {
          stampLike.style.opacity = progress;
          stampPass.style.opacity = 0;
        } else if (currentX < -15) {
          stampPass.style.opacity = progress;
          stampLike.style.opacity = 0;
        } else {
          stampLike.style.opacity = 0;
          stampPass.style.opacity = 0;
        }
      };

      const onPointerUp = () => {
        if (!isDragging) return;
        isDragging = false;
        card.classList.remove("card-dragging");
        card.classList.add("card-spring");

        const threshold = 90;
        if (currentX > threshold) {
          completeVote(dish, "like", card);
        } else if (currentX < -threshold) {
          completeVote(dish, "pass", card);
        } else {
          card.style.transform = "translate(0px, 0px) rotate(0deg)";
          stampLike.style.opacity = 0;
          stampPass.style.opacity = 0;
        }
        currentX = 0;
      };

      card.addEventListener("mousedown", onPointerDown);
      window.addEventListener("mousemove", onPointerMove);
      window.addEventListener("mouseup", onPointerUp);

      card.addEventListener("touchstart", onPointerDown, { passive: true });
      card.addEventListener("touchmove", onPointerMove, { passive: true });
      card.addEventListener("touchend", onPointerUp);
    }

    function completeVote(dish, action, cardEl = null) {
      if (!dish || appState.swipedIds.includes(dish.id)) return;
      appState.swipedIds.push(dish.id);

      const topCard = cardEl || document.querySelector(".swipe-card.z-20");
      if (topCard) {
        topCard.classList.add("card-spring");
        const stampLike = topCard.querySelector(".stamp-like");
        const stampPass = topCard.querySelector(".stamp-pass");

        if (action === "pass") {
          if (stampPass) stampPass.style.opacity = 1;
          topCard.style.transform = "translate(-420px, 40px) rotate(-22deg)";
          topCard.style.opacity = "0";
        } else {
          if (stampLike) stampLike.style.opacity = 1;
          topCard.style.transform = "translate(420px, 40px) rotate(22deg)";
          topCard.style.opacity = "0";
        }
      }

      if (action === "like") {
        dish.likes += 1;
        dish.score += 12;
        appState.userPoints += 1;
        showToast(`🔥 MIAM ! +1 pt pour toi • ${dish.author} grimpe !`, "success");
      } else if (action === "super") {
        dish.likes += 3;
        dish.score += 32;
        appState.userPoints += 3;
        showToast(`⭐ SUPER-CHEF ! +3 pts pour toi • +32 au plat !`, "super");
      } else {
        dish.passes += 1;
        dish.score = Math.max(1000, dish.score - 4);
      }

      saveState();
      updateHeaderAndWalletUI();

      setTimeout(() => {
        renderSwipeDeck();
        renderLeaderboard();
      }, 240);
    }

    // ==================== 5. LEADERBOARD (TOP TIERS) LOGIC ====================
    function renderLeaderboard() {
      const podiumEl = document.getElementById("podium-container");
      const listEl = document.getElementById("ranking-list");
      const subtitleEl = document.getElementById("leaderboard-subtitle");

      subtitleEl.textContent = `Classement en direct • ${appState.selectedZone === "ALL" ? "Toute la France" : appState.selectedZone}`;

      const filtered = appState.dishes
        .filter(d => {
          const zMatch = appState.selectedZone === "ALL" || d.zone === appState.selectedZone;
          const cMatch = leaderboardCategoryFilter === "ALL" || d.category === leaderboardCategoryFilter;
          return zMatch && cMatch;
        })
        .sort((a, b) => b.score - a.score);

      if (filtered.length === 0) {
        podiumEl.innerHTML = `<p class="text-center text-xs text-slate-400 py-6">Aucun plat dans cette catégorie pour le moment.</p>`;
        listEl.innerHTML = "";
        return;
      }

      const [first, second, third] = [filtered[0], filtered[1], filtered[2]];

      const renderPodiumSpot = (dish, rank) => {
        if (!dish) return `<div class="flex-1"></div>`;
        const config = {
          1: { medal: "👑", ring: "ring-amber-400", height: "h-24", imgSize: "w-16 h-16" },
          2: { medal: "🥈", ring: "ring-slate-400", height: "h-16", imgSize: "w-13 h-13" },
          3: { medal: "🥉", ring: "ring-orange-500", height: "h-12", imgSize: "w-12 h-12" }
        }[rank];

        return `
          <div class="flex-1 flex flex-col items-center text-center min-w-0">
            <div class="relative mb-1.5">
              <img src="${dish.image}" alt="${dish.title}" class="${config.imgSize} rounded-2xl object-cover ring-3 ${config.ring} shadow-md" />
              <span class="absolute -top-2.5 -right-2 text-base drop-shadow-xs">${config.medal}</span>
            </div>
            <p class="text-[11px] font-black text-white truncate w-full px-1">${dish.title}</p>
            <span class="text-[10px] font-semibold text-slate-400 truncate w-full">${dish.author}</span>
            <div class="mt-1.5 w-full ${config.height} rounded-t-2xl ${rank === 1 ? 'bg-gradient-to-t from-amber-500/25 to-orange-500/15 border-t-2 border-amber-400' : 'bg-[#0f1115] border-t border-[#282e3a]'} flex flex-col items-center justify-center px-1">
              <span class="text-xs font-black text-white">${dish.score}</span>
              <span class="text-[9px] font-bold text-emerald-400">${getApprovalRate(dish)}% 🔥</span>
            </div>
          </div>
        `;
      };

      podiumEl.innerHTML = `
        <div class="flex items-end justify-between gap-2 pt-2">
          ${renderPodiumSpot(second, 2)}
          ${renderPodiumSpot(first, 1)}
          ${renderPodiumSpot(third, 3)}
        </div>
        ${first ? `
          <div class="mt-2.5 pt-2 border-t border-orange-500/20 flex items-center justify-between text-[11px]">
            <span class="font-bold text-amber-300">🎁 En tête pour le gain du jour :</span>
            <span class="font-black text-white truncate max-w-[160px]">${first.author}</span>
          </div>
        ` : ""}
      `;

      const rest = filtered.slice(3);
      if (rest.length === 0) {
        listEl.innerHTML = `<p class="text-center text-[11px] text-slate-500 py-3">Poste ton plat pour challenger le podium !</p>`;
      } else {
        listEl.innerHTML = rest.map((dish, i) => {
          const rank = i + 4;
          const approval = getApprovalRate(dish);
          return `
            <div class="bg-[#171a21] border border-[#252a34] rounded-2xl p-2.5 flex items-center gap-3 ${dish.isUserPost ? 'ring-2 ring-orange-500 bg-orange-950/20' : ''}">
              <span class="w-6 text-center text-xs font-black text-slate-500">#${rank}</span>
              <img src="${dish.image}" alt="${dish.title}" class="w-13 h-13 rounded-xl object-cover shrink-0" />
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-1.5">
                  <span class="text-[10px] font-extrabold px-2 py-0.5 rounded-full ${
                    dish.category === 'Fait maison' ? 'bg-emerald-500/15 text-emerald-400' :
                    dish.category === 'Restaurant' ? 'bg-orange-500/15 text-orange-400' : 'bg-purple-500/15 text-purple-400'
                  }">${dish.category}</span>
                  <span class="text-[10px] text-slate-500 font-medium">${dish.postedAgo}</span>
                </div>
                <h4 class="text-xs font-extrabold text-white truncate mt-0.5">${dish.title}</h4>
                <p class="text-[11px] text-slate-400 truncate">${dish.author} • ${dish.zone}</p>
              </div>
              <div class="text-right shrink-0">
                <div class="text-xs font-black text-white">${dish.score} pts</div>
                <div class="text-[10px] font-bold text-emerald-400">${approval}% 🔥</div>
              </div>
            </div>
          `;
        }).join("");
      }
    }

    // ==================== 6. POST DISH & AI SCAN SIMULATION ====================
    let currentPostImage = "";
    let currentAiMacros = { kcal: 620, p: 32, g: 58, l: 24 };

    function setPostPreview(url) {
      currentPostImage = url;
      document.getElementById("post-preview-empty").classList.add("hidden");
      document.getElementById("post-preview-filled").classList.remove("hidden");
      document.getElementById("post-preview-img").src = url;
    }

    function clearPostPreview() {
      currentPostImage = "";
      document.getElementById("post-preview-empty").classList.remove("hidden");
      document.getElementById("post-preview-filled").classList.add("hidden");
      document.getElementById("post-preview-img").src = "";
      document.getElementById("ai-nutrition-box").classList.add("hidden");
    }

    // Compress uploaded image slightly via canvas so localStorage persistence stays super fast
    document.getElementById("photo-input").addEventListener("change", (e) => {
      const file = e.target.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (ev) => {
        const img = new Image();
        img.onload = () => {
          const maxW = 720;
          const scale = Math.min(1, maxW / img.width);
          const canvas = document.createElement("canvas");
          canvas.width = img.width * scale;
          canvas.height = img.height * scale;
          const ctx = canvas.getContext("2d");
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          const compressedDataUrl = canvas.toDataURL("image/jpeg", 0.78);
          setPostPreview(compressedDataUrl);
          showToast("Photo chargée ! Lance l'analyse IA ✨", "info");
        };
        img.src = ev.target.result;
      };
      reader.readAsDataURL(file);
    });

    document.getElementById("clear-photo-btn").addEventListener("click", clearPostPreview);

    document.querySelectorAll(".sample-dish-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        setPostPreview(btn.dataset.url);
        document.getElementById("dish-title").value = btn.dataset.title;
        document.getElementById("dish-category").value = btn.dataset.cat;
        document.getElementById("dish-resto").value = btn.dataset.resto;
        document.getElementById("dish-desc").value = btn.dataset.desc;
        toggleRestoField();

        currentAiMacros = {
          kcal: parseInt(btn.dataset.kcal, 10),
          p: parseInt(btn.dataset.p, 10),
          g: parseInt(btn.dataset.g, 10),
          l: parseInt(btn.dataset.l, 10)
        };
        updateAiMacroBox();
        showToast("Plat d'exemple chargé + analysé par l'IA !", "success");
      });
    });

    function toggleRestoField() {
      const cat = document.getElementById("dish-category").value;
      const wrapper = document.getElementById("resto-name-wrapper");
      if (cat === "Restaurant") {
        wrapper.classList.remove("hidden");
      } else {
        wrapper.classList.add("hidden");
      }
    }
    document.getElementById("dish-category").addEventListener("change", toggleRestoField);

    function updateAiMacroBox() {
      document.getElementById("ai-kcal-badge").textContent = `${currentAiMacros.kcal} kcal`;
      document.getElementById("ai-prot").textContent = `${currentAiMacros.p}g`;
      document.getElementById("ai-carbs").textContent = `${currentAiMacros.g}g`;
      document.getElementById("ai-fats").textContent = `${currentAiMacros.l}g`;
      document.getElementById("ai-nutrition-box").classList.remove("hidden");
    }

    document.getElementById("ai-analyze-btn").addEventListener("click", async () => {
      if (!currentPostImage) {
        showToast("Ajoute d'abord une photo ou choisis un exemple !", "error");
        return;
      }

      const btn = document.getElementById("ai-analyze-btn");
      const btnText = document.getElementById("ai-btn-text");
      const btnIcon = document.getElementById("ai-btn-icon");
      const scanOverlay = document.getElementById("ai-scan-overlay");

      btn.disabled = true;
      btnIcon.textContent = "⏳";
      btnText.textContent = "Analyse IA en cours...";
      scanOverlay.classList.remove("hidden");

      await new Promise(r => setTimeout(r, 1100));

      if (!document.getElementById("dish-title").value.trim()) {
        const aiPresets = [
          { title: "Assiette Gourmande Équilibrée", cat: "Fait maison", desc: "Préparation maison fraîche avec protéines grillées et légumes croquants.", kcal: 560, p: 36, g: 48, l: 21 },
          { title: "Création Signature du Chef", cat: "Restaurant", desc: "Dressage soigné, textures croustillantes et sauce maison parfumée.", kcal: 710, p: 34, g: 62, l: 33 },
          { title: "Recette Fusion Street-Food", cat: "Concept", desc: "Association originale pensée pour le battle culinaire du jour.", kcal: 640, p: 28, g: 66, l: 27 }
        ];
        const pick = aiPresets[Math.floor(Math.random() * aiPresets.length)];
        document.getElementById("dish-title").value = pick.title;
        document.getElementById("dish-category").value = pick.cat;
        document.getElementById("dish-desc").value = pick.desc;
        toggleRestoField();
        currentAiMacros = { kcal: pick.kcal, p: pick.p, g: pick.g, l: pick.l };
      }

      scanOverlay.classList.add("hidden");
      updateAiMacroBox();
      btn.disabled = false;
      btnIcon.textContent = "✨";
      btnText.textContent = "Analyser mon plat avec l'IA (Titre + Macros)";
      showToast("✨ Plat détecté & macros estimées !", "success");
    });

    document.getElementById("publish-dish-form").addEventListener("submit", (e) => {
      e.preventDefault();
      const title = document.getElementById("dish-title").value.trim();
      const category = document.getElementById("dish-category").value;
      const zone = document.getElementById("dish-zone").value;
      const restaurantName = document.getElementById("dish-resto").value.trim();
      const description = document.getElementById("dish-desc").value.trim() || "Tout juste publié dans le battle du jour !";

      if (!title) {
        showToast("Indique le nom de ton plat !", "error");
        return;
      }

      const imageToUse = currentPostImage || "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=900&q=80";

      const newDish = {
        id: "user_" + Date.now(),
        title,
        author: "@toi_chef",
        zone,
        distance: "Sur place",
        postedAgo: "À l'instant",
        category,
        restaurantName: category === "Restaurant" ? restaurantName : "",
        description,
        image: imageToUse,
        score: 1270,
        likes: 18,
        passes: 1,
        kcal: currentAiMacros.kcal,
        protein: currentAiMacros.p,
        carbs: currentAiMacros.g,
        fat: currentAiMacros.l,
        isUserPost: true
      };

      appState.dishes.unshift(newDish);
      appState.userPoints += 25;
      appState.selectedZone = zone;

      saveState();
      updateHeaderAndWalletUI();

      e.target.reset();
      clearPostPreview();
      toggleRestoField();

      renderSwipeDeck();
      renderLeaderboard();
      switchTab("leaderboard");
      showToast("🚀 Plat publié ! +25 pts & entrée au Top Tiers !", "super");
    });

    // ==================== 7. REWARDS SHOP & DEPLOYMENT ====================
    function renderRewardsShop() {
      const container = document.getElementById("rewards-shop-list");
      container.innerHTML = REWARDS_CATALOG.map(item => {
        const isUnlocked = appState.unlockedRewards.includes(item.id);
        return `
          <div class="bg-[#171a21] border ${isUnlocked ? 'border-emerald-500/50 bg-emerald-950/20' : 'border-[#252a34]'} rounded-2xl p-3.5 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-11 h-11 rounded-2xl bg-[#0f1115] border border-[#282e3a] text-xl flex items-center justify-center shrink-0">${item.emoji}</div>
              <div class="min-w-0">
                <span class="text-[10px] font-extrabold ${isUnlocked ? 'text-emerald-400' : 'text-orange-400'}">${isUnlocked ? '✅ Débloqué' : `${item.cost} pts requis`}</span>
                <h4 class="text-xs font-extrabold text-white truncate mt-0.5">${item.title}</h4>
                <p class="text-[11px] text-slate-400 truncate">${item.partner}</p>
                ${isUnlocked ? `<div class="mt-1 inline-block bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 text-[10px] font-black px-2 py-0.5 rounded-md">CODE : ${item.code}</div>` : ''}
              </div>
            </div>
            ${isUnlocked ? '' : `
              <button data-reward-id="${item.id}" class="redeem-btn shrink-0 bg-orange-500 hover:bg-orange-600 text-white text-xs font-extrabold px-3.5 py-2 rounded-xl transition active:scale-95">
                Débloquer
              </button>
            `}
          </div>
        `;
      }).join("");

      document.querySelectorAll(".redeem-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          const item = REWARDS_CATALOG.find(r => r.id === btn.dataset.rewardId);
          if (!item) return;
          if (appState.userPoints < item.cost) {
            showToast(`Il te manque ${item.cost - appState.userPoints} pts ! Vote ou poste un plat 🔥`, "error");
            return;
          }
          appState.userPoints -= item.cost;
          appState.unlockedRewards.push(item.id);
          saveState();
          updateHeaderAndWalletUI();
          renderRewardsShop();
          showToast(`🎉 Récompense débloquée ! Code : ${item.code}`, "success");
        });
      });
    }

    function downloadStandaloneHTML() {
      try {
        const htmlContent = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
        const blob = new Blob([htmlContent], { type: "text/html;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "index.html";
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
        showToast("⬇️ Fichier index.html téléchargé !", "success");
      } catch (e) {
        showToast("Impossible de lancer le téléchargement ici.", "error");
      }
    }

    // ==================== 8. NAVIGATION, MODALS & EVENT LISTENERS ====================
    function switchTab(tabName) {
      ["swipe", "leaderboard", "post", "rewards"].forEach(t => {
        const section = document.getElementById(`tab-${t}`);
        if (t === tabName) {
          section.classList.remove("hidden");
        } else {
          section.classList.add("hidden");
        }
      });

      document.querySelectorAll(".nav-btn").forEach(btn => {
        if (btn.dataset.tab === tabName) {
          btn.classList.add("active", "text-orange-400", "bg-orange-500/15", "font-extrabold");
          btn.classList.remove("text-slate-400", "font-bold");
        } else {
          btn.classList.remove("active", "text-orange-400", "bg-orange-500/15", "font-extrabold");
          btn.classList.add("text-slate-400", "font-bold");
        }
      });
    }

    document.querySelectorAll(".nav-btn").forEach(btn => {
      btn.addEventListener("click", () => switchTab(btn.dataset.tab));
    });

    // Install Modal & Prompt Handlers
    function openInstallModal() {
      if (deferredInstallPrompt) {
        document.getElementById("native-install-box").classList.remove("hidden");
      }
      document.getElementById("install-modal").classList.remove("hidden");
    }

    function closeInstallModal() {
      document.getElementById("install-modal").classList.add("hidden");
    }

    document.getElementById("header-install-btn").addEventListener("click", openInstallModal);
    document.getElementById("banner-install-btn").addEventListener("click", openInstallModal);
    document.getElementById("open-install-modal-secondary").addEventListener("click", openInstallModal);
    document.getElementById("close-install-modal").addEventListener("click", closeInstallModal);

    document.getElementById("install-modal").addEventListener("click", (e) => {
      if (e.target.id === "install-modal") closeInstallModal();
    });

    document.getElementById("trigger-native-install").addEventListener("click", async () => {
      if (!deferredInstallPrompt) return;
      deferredInstallPrompt.prompt();
      const { outcome } = await deferredInstallPrompt.userChoice;
      if (outcome === "accepted") {
        showToast("🎉 Show My Food installé sur ton écran !", "success");
        closeInstallModal();
      }
      deferredInstallPrompt = null;
    });

    document.getElementById("close-banner-btn").addEventListener("click", () => {
      appState.bannerDismissed = true;
      saveState();
      document.getElementById("install-banner").classList.add("hidden");
    });

    document.getElementById("download-html-btn").addEventListener("click", downloadStandaloneHTML);
    document.getElementById("modal-download-html").addEventListener("click", downloadStandaloneHTML);

    // Zone Selector
    document.getElementById("zone-selector").addEventListener("change", (e) => {
      appState.selectedZone = e.target.value;
      saveState();
      updateHeaderAndWalletUI();
      renderSwipeDeck();
      renderLeaderboard();
    });

    // Service Slot Toggle
    document.getElementById("toggle-slot-btn").addEventListener("click", () => {
      currentSlotIndex = (currentSlotIndex + 1) % serviceSlots.length;
      document.getElementById("service-slot-label").textContent = serviceSlots[currentSlotIndex];
      showToast(`Créneau : ${serviceSlots[currentSlotIndex]}`, "info");
    });

    // Swipe Category Pills
    document.querySelectorAll(".swipe-cat-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        swipeCategoryFilter = btn.dataset.swipeCat;
        document.querySelectorAll(".swipe-cat-btn").forEach(b => {
          b.className = "swipe-cat-btn px-3 py-1 rounded-full text-xs font-bold bg-[#171a21] text-slate-300 border border-[#282e3a] hover:border-orange-500/40 transition";
        });
        btn.className = "swipe-cat-btn active px-3 py-1 rounded-full text-xs font-extrabold bg-orange-500 text-white shadow-xs transition";
        renderSwipeDeck();
      });
    });

    // Leaderboard Category Pills
    document.querySelectorAll(".lb-cat-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        leaderboardCategoryFilter = btn.dataset.lbCat;
        document.querySelectorAll(".lb-cat-btn").forEach(b => {
          b.className = "lb-cat-btn px-3 py-1.5 rounded-full text-xs font-bold bg-[#171a21] text-slate-300 border border-[#282e3a] transition";
        });
        btn.className = "lb-cat-btn px-3 py-1.5 rounded-full text-xs font-extrabold bg-orange-500 text-white shadow-xs transition";
        renderLeaderboard();
      });
    });

    // Bottom Swipe Action Buttons
    document.getElementById("btn-pass").addEventListener("click", () => {
      const nextDish = getFilteredSwipeDishes()[0];
      if (nextDish) completeVote(nextDish, "pass");
    });
    document.getElementById("btn-like").addEventListener("click", () => {
      const nextDish = getFilteredSwipeDishes()[0];
      if (nextDish) completeVote(nextDish, "like");
    });
    document.getElementById("btn-super").addEventListener("click", () => {
      const nextDish = getFilteredSwipeDishes()[0];
      if (nextDish) completeVote(nextDish, "super");
    });

    // Demo Reset Button
    document.getElementById("reset-demo-btn").addEventListener("click", () => {
      localStorage.removeItem(STORAGE_KEY);
      appState = {
        userPoints: 140,
        selectedZone: "Paris 11e • Bastille",
        swipedIds: [],
        unlockedRewards: [],
        dishes: JSON.parse(JSON.stringify(DEFAULT_DISHES)),
        bannerDismissed: false
      };
      document.getElementById("install-banner").classList.remove("hidden");
      updateHeaderAndWalletUI();
      renderSwipeDeck();
      renderLeaderboard();
      renderRewardsShop();
      showToast("🔄 Démo réinitialisée à zéro !", "info");
    });

    // ==================== BOOTSTRAP APP ====================
    loadState();
    initPWA();
    updateHeaderAndWalletUI();
    renderSwipeDeck();
    renderLeaderboard();
    renderRewardsShop();
  </script>
</body>
</html>
